// NOTE: Shader automatically converted from Godot Engine 4.7.2.stable's StandardMaterial3D.

shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx;

uniform float distance_fade_min : hint_range(0.0, 4096.0, 0.01);
uniform float distance_fade_max : hint_range(0.0, 4096.0, 0.01);

const vec3 MAGIC_D = vec3(0.06711056, 0.00583715, 52.9829189);

uniform sampler2D texture_albedo: source_color, filter_nearest, repeat_disable;
uniform sampler2D texture_emission: source_color, filter_nearest, repeat_disable;

void fragment() {
	vec3 albedo_tex = texture(texture_albedo, UV).rgb;
	vec3 emission_tex = texture(texture_emission, UV).rgb;

	ALBEDO = albedo_tex;
	EMISSION = albedo_tex * emission_tex;
	METALLIC = 0.0;
	ROUGHNESS = 0.8;

	// distance fade: pixel dither (generated by engine)
	float fade_distance = length(VERTEX);

	// interleaved gradient noise, which is fast but still looks good
	float fade = clamp(smoothstep(distance_fade_min, distance_fade_max, fade_distance), 0.0, 1.0);
	// hard cap to prevent a few stray pixels from remaining when past the fade-out distance
	if (fade < 0.001 || fade < fract(MAGIC_D.z * fract(dot(FRAGCOORD.xy, MAGIC_D.xy)))) {
		discard;
	}
}
